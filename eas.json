{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_NETWORK_MODE": "testnet" },
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_NETWORK_MODE": "testnet" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_NETWORK_MODE": "mainnet" }
    }
  }
}
